generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model chunks {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id         String                @db.Uuid
  chunk_index         Int
  content             String
  metadata            Json                  @default("{}")
  // Dimension is fixed at 1536 to match EMBEDDING_DIM's default (see
  // apps/ai-service/config.py) — baked into the column type just like the
  // old ad hoc `CREATE TABLE` did. Changing it needs a hand-authored
  // migration (ALTER COLUMN TYPE + full reindex), same as before.
  embedding           Unsupported("vector(1536)")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  knowledge_documents knowledge_documents   @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([document_id])
  // The real vector index (ivfflat today, hnsw after the hand-authored
  // migration) is NOT modeled here on purpose — Prisma can't express
  // `USING hnsw`/`USING ivfflat`, and letting it "own" a plain index here
  // would make a future `migrate dev` diff try to replace the real index
  // with an ordinary btree one. See prisma/README.md.
}

model knowledge_documents {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  doc_type        String   @default("general")
  source_filename String?
  content_hash    String
  content         String   @default("")
  status          String   @default("processing")
  chunk_count     Int      @default(0)
  embedding_model String?
  metadata        Json     @default("{}")
  uploaded_by     String?
  updated_by      String?
  deleted_by      String?
  deleted_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  chunks          chunks[]
  category        knowledge_categories @relation(fields: [doc_type], references: [code])

  // NOT modeled here on purpose: a partial UNIQUE index on content_hash
  // (WHERE deleted_at IS NULL) and a generated `search_vector tsvector`
  // column + GIN index for full-text search (backs
  // GET /knowledge/status?q=...). Prisma's schema language can't express
  // a `where` clause on @@unique/@@index (see prisma/prisma#3627, still
  // open as of this writing — confirmed empirically, `prisma validate`
  // rejects it) or GENERATED ALWAYS AS columns at all. Both are
  // hand-authored raw SQL migrations instead — see prisma/README.md.
  @@index([status])
  @@index([doc_type])
}

// knowledge_document_events is intentionally NOT modeled here — its
// event_type CHECK constraint has no schema.prisma syntax (prisma/prisma
// #3388, still open) — it's a hand-authored raw SQL migration instead.
// See prisma/README.md and prisma/migrations/20260821220700_knowledge_document_events/.

// The 7 real categories already hardcoded in
// apps/web/src/app/admin/knowledge/page.tsx's DOC_TYPES constant — this
// table makes them DB-validated instead of free text. `code` is the exact
// string the frontend already sends as `doc_type`, so knowledge_documents
// keeps that column name/type (TEXT) unchanged; only an FK is added.
model knowledge_categories {
  code        String   @id
  label       String
  description String?
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  knowledge_documents knowledge_documents[]
}

model prompt_templates {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @unique
  version       Int      @default(1)
  system_prompt String
  is_active     Boolean  @default(true)
  created_by    String?
  updated_by    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model retrieval_logs {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id          String?
  query               String
  intent              String?
  retrieved_chunk_ids String[] @default([]) @db.Uuid
  scores              Json     @default("{}")
  confidence_score    Float?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([session_id, created_at])
  @@index([intent])
}

model runtime_settings {
  key        String   @id
  value      String
  updated_by String?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}
