# Postgres / pgvector — dedicated to ai-service, separate from the main app's MongoDB
DATABASE_URL=postgresql://localhost:5432/career_compass_rag
EMBEDDING_DIM=1536

# Service-to-service auth — must match Nest's AI_SERVICE_INTERNAL_TOKEN
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-shared-secret

# ── LLM provider ────────────────────────────────────────────────────────────
# LLM_PROVIDER / EMBEDDING_PROVIDER are auto-detected from which keys are
# present below if left unset (openai > azure_openai > gemini > fallback).
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=

# Azure OpenAI (alternative to OpenAI — set these instead)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-06-01

# Gemini (alternative)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Ollama (alternative — local, no key; set USE_OLLAMA=true to auto-select it)
# USE_OLLAMA=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── RAG tuning ────────────────────────────────────────────────────────────
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50
RETRIEVAL_TOP_K=8
RERANK_TOP_N=5
MAX_UPLOAD_MB=10
MAX_HISTORY_TURNS=6
