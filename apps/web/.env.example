# Base URL the frontend calls for the API — proxied through next.config.js's
# /api/v1/:path* rewrite in dev; point this at the real API origin in prod.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Identity Services client ID (Google Cloud Console → Credentials).
# Must match GOOGLE_CLIENT_ID in apps/api/.env. Leave unset and the Google
# sign-in button renders as disabled/unavailable instead of erroring.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
