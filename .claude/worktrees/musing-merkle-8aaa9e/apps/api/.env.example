# Server
PORT=3000
CORS_ORIGIN=http://localhost:3001

# MongoDB
MONGO_URI=mongodb://localhost:27017/career-compass-dev

# JWT — must be different values, min 32 chars each
JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-for-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (SMTP / for admin password reset + student email verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=CareerCompass AI <no-reply@careercompass.ai>

# Token expiry
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Google Sign-In (Identity Services) — the OAuth client ID from Google Cloud
# Console, used as the `audience` when verifying ID tokens server-side.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env. Leave unset to
# disable Google sign-in (returns 503 instead of accepting any token).
GOOGLE_CLIENT_ID=

# AI Counsellor — Python RAG microservice (apps/ai-service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-shared-secret
AI_SERVICE_TIMEOUT_MS=30000

# Security module
# 64-char hex string (32 bytes) — AES-256-GCM key used to encrypt TOTP
# secrets at rest. Generate with: openssl rand -hex 32
SECURITY_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
TWO_FA_ISSUER_NAME=CareerCompass AI
# 0 disables password expiry
PASSWORD_EXPIRY_DAYS=0
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=30
REAUTH_TOKEN_TTL_MINUTES=5

# Student Reports & Export module
# Local-disk root for generated report files (PDF/Excel/CSV/HTML).
STUDENT_REPORTS_STORAGE_DIR=./storage/reports
# Chromium/Chrome executable used by Puppeteer for PDF rendering. Required
# in Docker (installed via `apk add chromium`); optional in local dev if a
# system Chrome is found at a standard install path (see pdf-renderer.service.ts).
PUPPETEER_EXECUTABLE_PATH=
