{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/web"],
      "port": 3001
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--prefix", "apps/api"],
      "port": 3000
    },
    {
      "name": "ai-service",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd apps/ai-service && ./.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000"],
      "port": 8000
    }
  ]
}
